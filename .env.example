NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://paygate:paygate@localhost:5432/paygate
REDIS_URL=redis://localhost:6379
PUBLIC_URL=http://localhost:3000

# Stripe: use test-mode keys. Leave STRIPE_SECRET_KEY as-is (not sk_*) to run with the
# built-in fake gateway that still verifies webhook signatures with STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=fake
STRIPE_WEBHOOK_SECRET=whsec_local_dev_secret
STRIPE_WEBHOOK_TOLERANCE=300

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_RPM=60

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RESET_MS=30000
ASK_COST_CREDITS=1
SENTRY_DSN=
